    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "start": "electron-vite preview",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:integration": "node scripts/test-integration.mjs",
    "test:integration:noise": "node scripts/test-integration.mjs --noise-reduction",
    "screenshots": "electron-vite build && node scripts/screenshots/run.mjs",
    "typecheck": "pnpm check:boundaries && pnpm check:tests && node node_modules/@typescript/native/bin/tsc -p tsconfig.node.json && svelte-check --tsconfig tsconfig.web.json",
    "check:tests": "node node_modules/@typescript/native/bin/tsc -p tsconfig.tests.json",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
